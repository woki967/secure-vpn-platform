{% set backend_path = service.backend_path | default('/', true) | trim %}
{% if backend_path in ['', '/'] %}
{% set upstream_path = '/' %}
{% elif backend_path.endswith('/') %}
{% set upstream_path = backend_path if backend_path.startswith('/') else '/' ~ backend_path %}
{% else %}
{% set upstream_path = (backend_path if backend_path.startswith('/') else '/' ~ backend_path) ~ '/' %}
{% endif %}
{% if service.path == '/' %}
        location / {
            proxy_pass http://{{ service.vpn_ip }}:{{ service.local_port }}{{ upstream_path }};

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
{% elif service.path.endswith('/') %}
        location {{ service.path }} {
            proxy_pass http://{{ service.vpn_ip }}:{{ service.local_port }}{{ upstream_path }};

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
{% else %}
        location = {{ service.path }} {
            return 301 {{ service.path }}/;
        }

        location {{ service.path }}/ {
            proxy_pass http://{{ service.vpn_ip }}:{{ service.local_port }}{{ upstream_path }};

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
{% endif %}
